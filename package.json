{
  "name": "vite-plugin-favicon",
  "version": "2.0.0-beta.1",
  "description": "Generate browser and app icons from source artwork in Vite.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-commonjs.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "vite": "^7.3.0 || ^8.3.0"
  },
  "dependencies": {
    "@types/node": "^22.19.0",
    "favigen": "https://github.com/josh-hemphill/favigen/releases/download/v1.2.0/favigen-1.2.0.tgz",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vite7": "npm:vite@7.3.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josh-hemphill/vite-plugin-favicon.git"
  },
  "bugs": "https://github.com/josh-hemphill/vite-plugin-favicon/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "keywords": [
    "vite-plugin",
    "favicon",
    "icons",
    "pwa",
    "webmanifest"
  ]
}
